## Server
PORT=8080

## Gemini
# Get an API key from Google AI Studio / Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Limit how many URLs to send to Gemini (avoid huge prompts)
GEMINI_URL_CAP=200

## Docker / Kali (tool runner)
# Docker container name (match compose: kali-engine)
KALI_CONTAINER_NAME=kali-engine

# FFuf: default wordlist path inside container (SecLists)
# Common paths: /usr/share/seclists/Discovery/Web-Content/common.txt or /home/SecLists/Discovery/Web-Content/common.txt
FFUF_DEFAULT_WORDLIST=/usr/share/seclists/Discovery/Web-Content/common.txt

# Mount for uploaded wordlists (backend/temp/wordlists -> this path in container)
KALI_WORDLIST_MOUNT=/mnt/wordlists

# (Optional) If you later mount a volume for katana results
KALI_RESULT_DIR=/opt/oneclickscan/result
KALI_VOLUME_HOST_ROOT=./kali-volume

