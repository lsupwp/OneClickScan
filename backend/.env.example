## Server
PORT=8080

## Gemini
# Get an API key from Google AI Studio / Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Limit how many URLs to send to Gemini (avoid huge prompts)
GEMINI_URL_CAP=200

## Docker / Kali (tool runner)
# Docker container name that has katana installed
KALI_CONTAINER_NAME=kali

# (Optional) If you later mount a volume and want katana to write results there
KALI_RESULT_DIR=/opt/oneclickscan/result
KALI_VOLUME_HOST_ROOT=./kali-volume

